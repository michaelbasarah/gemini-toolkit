# Required for index / ask / menu. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (defaults shown)
# GEMINI_MODEL=gemini-2.5-flash          # answers + menu extraction
# GT_EMBED_MODEL=gemini-embedding-001
# GT_EMBED_DIM=768                       # Matryoshka truncation; changing it re-indexes everything
# GT_DB=.gemini-toolkit/toolkit.db       # one SQLite file: chunks, vectors and the cost ledger
# GT_RATES=./my-rates.json               # your own $/1M-token rates, merged over src/rates.json
# GT_DAILY_BUDGET_USD=1.00               # refuse new calls once today's ledger total reaches this
